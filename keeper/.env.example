# Robinhood Chain mainnet
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# Dedicated hot wallet for the keeper. It only needs ETH for gas; it never holds vault funds.
# Its address must equal Registry.keeper().
KEEPER_PRIVATE_KEY=0x...

# From the deploy script output
LAUNCHER=0x...
# Block the Launcher was deployed in (bounds log scans)
START_BLOCK=0

# OpenSea API key. Leave empty to auto-mint a free-tier key (7 days, renewed automatically,
# low rate limits). For production, create a full key at https://opensea.io/settings/developer
OPENSEA_API_KEY=
# 1 = never call OpenSea (no floor buys)
SWEEP_DISABLED=0
OPENSEA_CHAIN=robinhood
SEAPORT=0x0000000000000068F116a894984e2DB1123eB395

# Ceiling = floor listing price + markup (bps), never above MAX_CEILING_ETH
CEILING_MARKUP_BPS=300
MAX_CEILING_ETH=5
# Harvest a router once this much ETH is pending
MIN_HARVEST_ETH=0.005
# Holders with at most this many tokens get no raffle tickets
MIN_TICKET_TOKENS=0

# Where raffle snapshots are written
SNAPSHOT_DIR=./snapshots
# Serve snapshots over HTTP (with CORS) on this port, e.g. https://keeper.example.com/<file>.json
# Set the site's config.js snapshotBaseUrl to that public URL (ending in /). 0 = off.
SNAPSHOT_PORT=8080
INTERVAL_SEC=60
# 1 = simulate every transaction but send nothing
DRY_RUN=0
LOG_CHUNK=50000
